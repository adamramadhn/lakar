{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lakar",
  "version": "0.1.0",
  "identifier": "id.lakar.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Lakar",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 375,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Lakar — viewer desain dan daemon lakard lokal",
    "longDescription": "Lakar menjalankan daemon lakard di komputer ini dan menampilkan desain yang dibuat agen lewat MCP.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/lakar-node"],
    "resources": ["resources/sidecar/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
