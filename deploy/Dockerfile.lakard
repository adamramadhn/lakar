# lakard headless — render worker (chromium-headless-shell via playwright-core).
# Build: docker build -f deploy/Dockerfile.lakard -t lakar-daemon .
# Run:   docker run -p 7466:7466 lakar-daemon
# Catatan: image ini besar (chromium + dependensi sistem). Untuk v1 render
# share snapshot dilakukan oleh lakard milik pemilik dokumen, bukan worker ini.
# bookworm (bukan alpine): playwright butuh glibc + lib sistem chromium.
FROM node:26-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@12.21.0 --activate
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter "@lakar/daemon..."

FROM deps AS build
COPY tsconfig.json ./
RUN pnpm --filter "@lakar/daemon..." build

FROM node:26-bookworm-slim
RUN corepack enable && corepack prepare pnpm@12.21.0 --activate
WORKDIR /repo
ENV NODE_ENV=production \
    LAKAR_PORT=7466 \
    LAKAR_DATA_DIR=/data \
    LAKAR_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/package.json /repo/pnpm-workspace.yaml /repo/tsconfig.base.json ./
# Chromium headless-shell + lib sistemnya — sama dengan CI
# (ci.yml: `pnpm --filter @lakar/daemon exec playwright-core install --with-deps`).
# LAKAR_BROWSERS_PATH dibaca config daemon sebagai browsers_path.
RUN pnpm --filter @lakar/daemon exec playwright-core install --with-deps chromium-headless-shell
VOLUME /data
EXPOSE 7466
CMD ["node", "packages/daemon/dist/main.js", "--headless"]
