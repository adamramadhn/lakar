# Salin ke .env dan isi.
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Kunci admin/service: dipakai lakard (LAKAR_CLOUD_KEY, fallback bila belum sign-in)
# dan admin API. Bukan identitas user — user sign-in pakai akun (lihat README).
LAKAR_API_KEY=ganti-dengan-token-rahasia-panjang
# Basis URL publik layanan api — WAJIB benar: dipakai untuk tautan share,
# redirect_uri OAuth, dan magic link (tidak pernah diambil dari Host request).
PUBLIC_BASE_URL=https://api.example.com

# --- Auth akun (passwordless) — semua opsional; isi yang dipakai saja ---
# Google OAuth: https://console.cloud.google.com → Credentials → OAuth client
#   Authorized redirect URI: ${PUBLIC_BASE_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: ${PUBLIC_BASE_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Basis redirect_uri OAuth bila beda dari PUBLIC_BASE_URL (biasanya sama — kosongkan).
OAUTH_CALLBACK_BASE=
# Magic link email via Resend (https://resend.com) — tanpa ini, link dicetak
# ke log container api (mode dev: DEV_MAGIC_LINK).
RESEND_API_KEY=
EMAIL_FROM=Lakar <login@example.com>
# Set 0 untuk mematikan fallback cetak-ke-log saat RESEND_API_KEY kosong.
DEV_MAGIC_LINK=1
