# Contoh reverse proxy TLS untuk Lakar Cloud (Caddy — TLS otomatis).
# Sesuaikan domain; jalankan: caddy run --config deploy/Caddyfile
# atau pasang di mesin yang sama dengan docker-compose.

# Layanan API + guest share page (/s/<token>).
api.example.com {
	reverse_proxy 127.0.0.1:8081
}

# Sync server WS — /room/<token> butuh dukungan WebSocket
# (Caddy meneruskannya otomatis; header Upgrade dijaga).
sync.example.com {
	reverse_proxy 127.0.0.1:8082
}
