# Image generik untuk layanan @lakar/* (api, sync).
# Build:  docker build -f deploy/Dockerfile.service --build-arg SERVICE=api -t lakar-api .
#         docker build -f deploy/Dockerfile.service --build-arg SERVICE=sync -t lakar-sync .
# Butuh konteks root repo (pnpm workspace — layanan mengimpor @lakar/schema/core lintas paket).
FROM node:26-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.21.0 --activate
WORKDIR /repo

# Layer dependensi: manifest saja dulu supaya cache tahan lama.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/schema/package.json packages/schema/
COPY packages/core/package.json packages/core/
COPY packages/daemon/package.json packages/daemon/
COPY services/api/package.json services/api/
COPY services/sync/package.json services/sync/
ARG SERVICE
RUN pnpm install --frozen-lockfile --filter "@lakar/${SERVICE}..." 

# Build: kompilasi layanan beserta dependensi workspace-nya.
FROM deps AS build
COPY tsconfig.json ./
COPY packages ./packages
COPY services ./services
ARG SERVICE
RUN pnpm --filter "@lakar/${SERVICE}..." build

# Runtime ramping: node_modules hasil install + dist.
FROM node:26-alpine
RUN corepack enable && corepack prepare pnpm@12.21.0 --activate
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages ./packages
COPY --from=build /repo/services ./services
COPY --from=build /repo/pnpm-workspace.yaml --from=build /repo/package.json ./
ARG SERVICE
ENV SERVICE=${SERVICE}
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- "http://127.0.0.1:${PORT:-8080}/healthz" || exit 1
CMD ["sh", "-c", "node services/${SERVICE}/dist/main.js"]
