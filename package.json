{
  "name": "lakar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/assert-node.mjs && tsc -b && pnpm --filter @lakar/viewer build",
    "test": "node scripts/assert-node.mjs && tsc -p tsconfig.test.json && vitest run",
    "clean": "tsc -b --clean",
    "lakard": "node packages/daemon/dist/main.js",
    "install-browser": "bash scripts/install-browser.sh",
    "bench:pendev": "node scripts/assert-node.mjs && node bench/dist/cli.js pendev-baseline",
    "bench:round": "node scripts/assert-node.mjs && node bench/dist/cli.js round"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "4.3.5",
    "@types/node": "26.6.6",
    "playwright-core": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
